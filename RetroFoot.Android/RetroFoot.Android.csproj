<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- a versao: a mesma do jogo (RetroFoot.App.csproj <Version>); o codigo da versao do
         Android (inteiro, so cresce) = maior x 10000 + menor x 100 + correcao (0.1.2 = 102).
         Mudar os dois a cada release, senao o Android nao instala a atualizacao -->
    <ApplicationDisplayVersion>0.1.2</ApplicationDisplayVersion>
    <ApplicationVersion>102</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- AOT: o codigo vai compilado para o processador no APK (sem JIT ao abrir cada tela) -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Debug: a prova (instala ao lado do jogo de verdade, com os dados dela) -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <ApplicationId>io.github.juansilveira.retrofoot.prova</ApplicationId>
    <ApplicationTitle>RetroFoot (prova)</ApplicationTitle>
  </PropertyGroup>
  <!-- Release: o RetroFoot, assinado sempre com a mesma chave (fora do repositorio, em
       ~/.config/retrofoot): sem ela o Android recusa as atualizacoes por cima. Os 32 bits
       (android-arm) tambem, para os celulares mais antigos -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationId>io.github.juansilveira.retrofoot</ApplicationId>
    <ApplicationTitle>RetroFoot</ApplicationTitle>
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(HOME)/.config/retrofoot/retrofoot-android.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>retrofoot</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>file:$(HOME)/.config/retrofoot/retrofoot-android.senha</AndroidSigningStorePass>
    <AndroidSigningKeyPass>file:$(HOME)/.config/retrofoot/retrofoot-android.senha</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RetroFoot.App\RetroFoot.App.csproj" />
  </ItemGroup>
</Project>
