<Project Sdk="Microsoft.NET.Sdk">
  <!-- As telas (Avalonia), iguais em Windows, Linux, macOS e Android -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- a versao do RetroFoot (mostrada no Sobre) -->
    <Version>0.1.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>
  <ItemGroup>
    <!-- o soak da interface (ferramentas/SoakUI) mexe nas esperas do leilao -->
    <InternalsVisibleTo Include="SoakUI" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RetroFoot.Motor\RetroFoot.Motor.csproj" />
  </ItemGroup>
</Project>
