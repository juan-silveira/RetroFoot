<Project Sdk="Microsoft.NET.Sdk">
  <!-- O motor do jogo: C# puro, sem tela. Por enquanto so o leitor de saves do launcher
       (o mesmo arquivo, sem copia). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- o catalogo de paises do jogo (o mesmo arquivo da interface): a reserva de quando um
         pais das equipas falta em countries.tsv (Dados.PaisDoArquivo) -->
    <EmbeddedResource Include="..\RetroFoot.App\Assets\paises.tsv" LogicalName="paises.tsv" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RetroFoot.Motor.Testes" />
  </ItemGroup>
</Project>
